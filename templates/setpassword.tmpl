{{define "setpassword"}}
<header class="mono-nav">
    <div class="nav-inner">
        <a href="/index" class="nav-brand">
            <img src="/assets/site-icon.png" alt="澪染" class="nav-brand-img">
            澪染
            <span class="nav-badge">{{if .HasAdmin}}修改密码{{else}}初始化{{end}}</span>
        </a>
        <div class="nav-actions">
            <button type="button" class="theme-toggle-btn mono-btn mono-btn-sm">[ 🌙 深色 ]</button>
        </div>
    </div>
</header>

<div class="page-container" style="max-width:520px;margin-top:4rem">
    <div style="border:2px solid var(--border);padding:3rem 2rem;background:var(--bg)">
        <div style="font-family:var(--font-mono);font-size:0.75rem;letter-spacing:0.15em;color:var(--muted-fg);margin-bottom:0.5rem">
            首次安装部署
        </div>
        <h1 class="preview-headline" style="font-size:1.8rem;margin-bottom:0.5rem">{{if .HasAdmin}}修改管理员密码{{else}}初始化超级管理员{{end}}</h1>
        <p style="font-size:0.85rem;color:var(--muted-fg);margin-bottom:2rem">
            {{if .HasAdmin}}
                本站已有管理员，修改密码需先验证当前密码。
            {{else}}
                首次安装，请设置您的管理员用户名和登录密码。
            {{end}}
        </p>

        {{if .Flash}}
            <div class="flash-bar" style="margin-bottom:1.5rem">
                <span>[ {{.FlashType | upper}} ] {{.Flash}}</span>
                <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;font-family:var(--font-mono)">[ ✕ ]</button>
            </div>
        {{end}}

        <form method="post">
            <input type="hidden" name="action" value="set_password">
            <input type="hidden" name="csrf" value="{{.CSRFToken}}">
            <div class="mono-form-group">
                <label class="mono-form-label">管理员用户名</label>
                <input type="text" name="username" class="mono-input" placeholder="例如: admin" value="{{.CurrentUsername}}" required autofocus>
            </div>
            {{if .HasAdmin}}
                <div class="mono-form-group">
                    <label class="mono-form-label">当前密码</label>
                    <input type="password" name="current_password" class="mono-input" placeholder="输入当前管理密码" required>
                </div>
            {{end}}
            <div class="mono-form-group">
                <label class="mono-form-label">{{if .HasAdmin}}新登录密码{{else}}登录密码{{end}}</label>
                <input type="password" name="password" class="mono-input" placeholder="输入管理密码" required>
            </div>
            <div class="mono-form-group">
                <label class="mono-form-label">确认登录密码</label>
                <input type="password" name="confirm_password" class="mono-input" placeholder="再次输入密码" required>
            </div>
            <button type="submit" class="mono-btn mono-btn-filled mono-btn-lg" style="width:100%;margin-top:1rem">完成初始化并进入后台 →</button>
        </form>
    </div>
</div>
{{end}}
